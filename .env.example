# ---------------------------------------------------------------------------
# tModLoader server (light) – all settings are environment variables.
# Changes take effect on the next container restart:
#   docker compose up -d        (re-creates the container after .env changes)
# ---------------------------------------------------------------------------

# --- Game server install -----------------------------------------------------
# "latest" = newest stable tModLoader release, or pin a tag like v2025.01.3.1
TMOD_VERSION=latest
# 1 = check GitHub for a newer release on every start (only with TMOD_VERSION=latest)
TMOD_AUTO_UPDATE=1

# --- Mods --------------------------------------------------------------------
# Steam Workshop IDs and/or collections, comma separated.
# Mods are downloaded/updated on every start and written to enabled.json.
# Example: TMOD_MODS=2824688072,2824688266,collection:2830000000
TMOD_MODS=
# Manually copied mods in ./data/tModLoader/Mods/<Name>.tmod to enable as well.
# Example: TMOD_LOCAL_MODS=MyPrivateMod,AnotherMod
TMOD_LOCAL_MODS=
# 1 = delete cached Workshop mods that are no longer listed in TMOD_MODS
TMOD_MOD_PRUNE=0
# use-cache = start with cached mods if Steam is unreachable; strict = fail instead
TMOD_MOD_OFFLINE_POLICY=use-cache
TMOD_DOWNLOAD_RETRIES=3
TMOD_DOWNLOAD_RETRY_DELAY=10

# --- Server ------------------------------------------------------------------
TMOD_PORT=7777
TMOD_HOST_PORT=7777
TMOD_MOTD=A tModLoader server powered by Docker!
# "N/A" disables the password. Alternatively set TMOD_PASS_FILE to a mounted file.
TMOD_PASS=docker
TMOD_MAXPLAYERS=8
TMOD_LANGUAGE=en-US
TMOD_SECURE=0
TMOD_NPCSTREAM=60
TMOD_UPNP=0
TMOD_PRIORITY=1

# --- World (only used when the world file does not exist yet) ---------------
TMOD_WORLDNAME=Docker
# 1 = small, 2 = medium, 3 = large
TMOD_WORLDSIZE=3
# 0 = classic/normal, 1 = expert, 2 = master, 3 = journey
TMOD_DIFFICULTY=1
TMOD_WORLDSEED=Docker
# random, corruption or crimson
TMOD_WORLDEVIL=random

# --- Custom serverconfig.txt instead of the settings above -------------------
# Yes = use /terraria-server/customconfig.txt (mount it in docker-compose.yml)
TMOD_USECONFIGFILE=No

# --- Runtime -----------------------------------------------------------------
# Minutes between automatic "save" commands; 0 disables
TMOD_AUTOSAVE_INTERVAL=10
TMOD_AUTOSAVE_MESSAGE=Scheduled world save starting.
TMOD_SHUTDOWN_MESSAGE=Server is shutting down NOW!
TMOD_SHUTDOWN_DELAY=3
TMOD_SHUTDOWN_TIMEOUT=90
# quiet, normal or debug
TMOD_LOG_LEVEL=normal

# --- Journey mode permissions (0 = locked, 1 = host only, 2 = everyone) ------
TMOD_JOURNEY_SETFROZEN=0
TMOD_JOURNEY_SETDAWN=0
TMOD_JOURNEY_SETNOON=0
TMOD_JOURNEY_SETDUSK=0
TMOD_JOURNEY_SETMIDNIGHT=0
TMOD_JOURNEY_GODMODE=0
TMOD_JOURNEY_WIND_STRENGTH=0
TMOD_JOURNEY_RAIN_STRENGTH=0
TMOD_JOURNEY_TIME_SPEED=0
TMOD_JOURNEY_RAIN_FROZEN=0
TMOD_JOURNEY_WIND_FROZEN=0
TMOD_JOURNEY_PLACEMENT_RANGE=0
TMOD_JOURNEY_SET_DIFFICULTY=0
TMOD_JOURNEY_BIOME_SPREAD=0
TMOD_JOURNEY_SPAWN_RATE=0
