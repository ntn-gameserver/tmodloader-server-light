# =============================================================================
# tModLoader Server (light) – Konfiguration
# Kopieren nach .env, anpassen, dann: docker compose up -d --build
# Nach Änderungen den Container neu erzeugen: docker compose up -d
# Server-Einstellungen allgemein: https://terraria.wiki.gg/wiki/Server
# =============================================================================


# --- Gameserver-Installation -------------------------------------------------

# tModLoader-Version: "latest" (neueste stabile Version) oder ein fester
# Release-Tag, z. B. v2025.01.3.1. Tags: https://github.com/tModLoader/tModLoader/releases
TMOD_VERSION=latest

# 1 = bei jedem Start prüfen, ob es eine neuere Version gibt, und sie installieren.
# 0 = installierte Version behalten. Wirkt nur mit TMOD_VERSION=latest.
TMOD_AUTO_UPDATE=1


# --- Mods ----------------------------------------------------------------------

# Steam-Workshop-Mods, mit Komma getrennt. Die Zahl steht in der Workshop-URL
# (…/filedetails/?id=2824688072). Ganze Collections mit "collection:<ID>".
# Die Mods werden bei jedem Start heruntergeladen, aktualisiert und aktiviert.
# Leer = die vorhandene enabled.json bleibt unverändert.
# Workshop: https://steamcommunity.com/app/1281930/workshop/
# Beispiel: TMOD_MODS=2824688072,2824688266,collection:2830000000
TMOD_MODS=


# --- Betrieb -------------------------------------------------------------------

# Chat-Nachricht an alle Spieler, wenn der Container gestoppt wird.
TMOD_SHUTDOWN_MESSAGE=Server is shutting down NOW!

# Minuten zwischen automatischen Speicherungen der Welt. 0 = aus.
TMOD_AUTOSAVE_INTERVAL=10


# --- Server --------------------------------------------------------------------

# "Yes" = eigene Config-Datei verwenden (in docker-compose.yml als
# /terraria-server/customconfig.txt einbinden). Alle Server- und Welt-
# Einstellungen unten werden dann ignoriert.
TMOD_USECONFIGFILE=No

# Nachricht des Tages, wird Spielern beim Betreten angezeigt.
TMOD_MOTD=A tModLoader server powered by Docker!

# Passwort zum Betreten des Servers. "N/A" = kein Passwort.
TMOD_PASS=docker

# Maximale Anzahl gleichzeitiger Spieler (1–255).
TMOD_MAXPLAYERS=8

# TCP-Port des Servers. Wird auch in docker-compose.yml als Host-Port genutzt.
TMOD_PORT=7777

# Sprache der Servermeldungen, z. B. en-US, de-DE, fr-FR.
TMOD_LANGUAGE=en-US

# 1 = Anti-Cheat-Schutz von Terraria einschalten, 0 = aus.
TMOD_SECURE=0

# Wie oft NPC-Daten an Clients gesendet werden. Niedriger = weniger
# Ruckeln/Skipping, dafür mehr Netzwerklast. Standard 60, 0 = aus.
TMOD_NPCSTREAM=60

# 1 = Port per UPnP automatisch im Router freigeben, 0 = aus.
# In Docker meist wirkungslos, Port lieber manuell weiterleiten.
TMOD_UPNP=0

# Prozesspriorität: 0 = Echtzeit, 1 = hoch, 2 = über normal,
# 3 = normal, 4 = unter normal, 5 = niedrig.
TMOD_PRIORITY=1


# --- Welt (wird nur beim Erstellen einer neuen Welt verwendet) ------------------

# Name der Welt. Existiert ./data/tModLoader/Worlds/<Name>.wld, wird sie geladen,
# sonst wird eine neue Welt mit den folgenden Einstellungen erzeugt.
TMOD_WORLDNAME=Docker

# Weltgröße: 1 = klein, 2 = mittel, 3 = groß.
TMOD_WORLDSIZE=3

# Schwierigkeit: 0 = Classic, 1 = Expert, 2 = Master, 3 = Journey (Reise-Modus).
# https://terraria.wiki.gg/wiki/Expert_Mode
# https://terraria.wiki.gg/wiki/Master_Mode
# https://terraria.wiki.gg/wiki/Journey_Mode
TMOD_DIFFICULTY=1

# Seed für die Weltgenerierung. Gleicher Seed = gleiche Welt.
# Spezielle Seeds (z. B. "not the bees"): https://terraria.wiki.gg/wiki/Secret_world_seeds
TMOD_WORLDSEED=Docker

# Böses Biom der Welt: random (zufällig), corruption oder crimson.
# https://terraria.wiki.gg/wiki/The_Corruption
# https://terraria.wiki.gg/wiki/The_Crimson
TMOD_WORLDEVIL=random


# --- Journey-Modus: Rechte für Kräfte -----------------------------------------
# Nur für Welten mit TMOD_DIFFICULTY=3.
# 0 = für alle gesperrt, 1 = nur der Host, 2 = alle Spieler.
# https://terraria.wiki.gg/wiki/Journey_Mode

# Zeit einfrieren
TMOD_JOURNEY_SETFROZEN=0
# Zeit auf Morgendämmerung setzen
TMOD_JOURNEY_SETDAWN=0
# Zeit auf Mittag setzen
TMOD_JOURNEY_SETNOON=0
# Zeit auf Abenddämmerung setzen
TMOD_JOURNEY_SETDUSK=0
# Zeit auf Mitternacht setzen
TMOD_JOURNEY_SETMIDNIGHT=0
# Gottmodus (unverwundbar)
TMOD_JOURNEY_GODMODE=0
# Windstärke ändern
TMOD_JOURNEY_WIND_STRENGTH=0
# Regenstärke ändern
TMOD_JOURNEY_RAIN_STRENGTH=0
# Zeitgeschwindigkeit ändern
TMOD_JOURNEY_TIME_SPEED=0
# Regen einfrieren
TMOD_JOURNEY_RAIN_FROZEN=0
# Wind einfrieren
TMOD_JOURNEY_WIND_FROZEN=0
# Größere Platzierreichweite für Blöcke
TMOD_JOURNEY_PLACEMENT_RANGE=0
# Schwierigkeit der Gegner ändern
TMOD_JOURNEY_SET_DIFFICULTY=0
# Ausbreitung von Corruption/Crimson/Hallow einfrieren
TMOD_JOURNEY_BIOME_SPREAD=0
# Spawnrate der Gegner ändern
TMOD_JOURNEY_SPAWN_RATE=0
